# ---------------------------------------------------------------------------
# Zonash storefront — self-hosted environment
# Copy to `.env` on the server and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# ---- Build-time (inlined into the browser bundle; safe to be public) ------
VITE_SUPABASE_URL=https://<project>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=<project>

# ---- Backend (server-only; never exposed to the browser) -----------------
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# ---- WooCommerce (direct mode — no Lovable gateway) ----------------------
# Generate under WooCommerce > Settings > Advanced > REST API (Read/Write).
WC_STORE_URL=https://your-woo-store.com
WC_CONSUMER_KEY=ck_xxx
WC_CONSUMER_SECRET=cs_xxx
# Shared secret configured under WooCommerce > Settings > Advanced > Webhooks.
WC_WEBHOOK_SECRET=<strong random string>

# ---- Customer session signing (phone + OTP cookie HMAC) ------------------
# Must stay stable across deploys or every customer is silently logged out.
# Generate once with: openssl rand -hex 32
CUSTOMER_SESSION_SECRET=

# ---- Steadfast Courier ---------------------------------------------------
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=

# ---- Hoorin customer verification ---------------------------------------
HOORIN_API_KEY=

# ---- SMS (BDBulkSMS) ----------------------------------------------------
BDBULKSMS_TOKEN=
BDBULKSMS_SENDER_ID=

# ---- Runtime ------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=production

# Canonical public origin of the storefront (no trailing slash). Used for
# canonical tags, og:url and sitemap.xml. Falls back to the Lovable host.
VITE_SITE_URL=https://zonash.com
